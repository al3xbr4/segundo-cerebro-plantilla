{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Documents/SegundoCerebro/scripts/sync.sh\" pull",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Documents/SegundoCerebro/scripts/sync.sh\" push",
            "shell": "bash",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
